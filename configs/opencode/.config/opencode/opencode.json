{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["oc-auth-switcher@1.0.0", "storyink@0.3.6"],
  "lsp": {},
  "agent": {},
  "mcp": {
    "purespectrum": {
      "type": "remote",
      "url": "https://purespectrum-mcp-prod.purespectrum.workers.dev/mcp",
      "enabled": true
    },
    "fd-forge-local": {
      "type": "remote",
      "enabled": false,
      "url": "http://localhost:8080/mcp"
    },
    "fd-forge": {
      "type": "remote",
      "enabled": false,
      "url": "https://forge.focaldata.com/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "ApiKey {env:FD_FORGE_MCP_API_KEY}"
      }
    },
    "fd-forge-dev": {
      "type": "remote",
      "url": "https://forge.focaldata.dev/mcp",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "ApiKey {env:FD_FORGE_MCP_API_KEY}"
      }
    },
    "kubefwd": {
      "type": "local",
      "command": ["kubefwd", "mcp"],
      "enabled": false
    },
    "notionMCP": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "mcp-remote", "https://mcp.notion.com/mcp"]
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--extension"],
      "enabled": true,
      "environment": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "DyfBXYMo3SK2ZVreuIp08aJFqMHUl1196yS6U2fBO_0"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "datadog": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.datadoghq.eu/v1/mcp",
      "headers": {
        "DD_API_KEY": "{env:DD_API_KEY}",
        "DD_APPLICATION_KEY": "{env:DD_APP_KEY}"
      }
    },
    "mempalace": {
      "type": "local",
      "enabled": false,
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-v",
        "mempalace-data:/data",
        "mempalace"
      ]
    },
    "takealot": {
      "type": "local",
      "enabled": false,
      "command": [
        "/Users/ice/.local/bin/uv",
        "--directory",
        "/Users/ice/projects/mcp-takealot",
        "run",
        "fastmcp",
        "run",
        "server.py:mcp"
      ]
    },
    "float": {
      "type": "local",
      "enabled": false,
      "command": [
        "/Users/ice/.local/bin/uv",
        "--directory",
        "/Users/ice/projects/mcp-float",
        "run",
        "fastmcp",
        "run",
        "server.py:mcp"
      ],
      "environment": {
        "FLOAT_EMAIL": "{env:FLOAT_EMAIL}",
        "FLOAT_PASSWORD": "{env:FLOAT_PASSWORD}"
      }
    },
    "open": {
      "type": "remote",
      "enabled": false,
      "url": "http://127.0.0.1:18081/mcp"
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "grep-app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "xero": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "/Users/ice/projects/mcp-xero",
        "run",
        "mcp-xero"
      ],
      "enabled": false,
      "environment": {
        "MCP_XERO_DELIVERY": "chrome",
        "MCP_XERO_BRIDGE_PORT": "8765"
      }
    }
  },
  "provider": {}
}

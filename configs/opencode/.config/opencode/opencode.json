{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["oc-auth-switcher@1.0.4", "storyink@0.6.0"],
  "compaction": {
    "buffer": "20%"
  },
  "experimental": {
    "subagent_depth": 2
  },
  "lsp": {},
  "agents": {},
  "mcp": {
    "servers": {
      "purespectrum": {
        "disabled": true,
        "type": "remote",
        "url": "https://purespectrum-mcp-prod.purespectrum.workers.dev/mcp"
      },
      "fd-forge-local": {
        "type": "remote",
        "disabled": true,
        "url": "http://localhost:8080/mcp"
      },
      "fd-forge": {
        "type": "remote",
        "disabled": true,
        "url": "https://forge.focaldata.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "ApiKey {env:FD_FORGE_MCP_API_KEY}"
        }
      },
      "fd-forge-dev": {
        "type": "remote",
        "url": "https://forge.focaldata.dev/mcp",
        "disabled": true,
        "oauth": false,
        "headers": {
          "Authorization": "ApiKey {env:FD_FORGE_MCP_API_KEY}"
        }
      },
      "kubefwd": {
        "type": "local",
        "command": ["kubefwd", "mcp"],
        "disabled": true
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      },
      "playwright": {
        "disabled": true,
        "type": "local",
        "command": ["npx", "@playwright/mcp@latest", "--extension"],
        "timeout": {
          "catalog": 120000,
          "execution": 120000
        },
        "environment": {
          "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "DyfBXYMo3SK2ZVreuIp08aJFqMHUl1196yS6U2fBO_0"
        }
      },
      "zen": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@mozilla/firefox-devtools-mcp@latest",
          "--firefox-path",
          "/Applications/Zen.app/Contents/MacOS/zen",
          "--profile-path",
          "/Users/ice/.cache/zen-mcp-profile"
        ],
        "disabled": true
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer {env:GITHUB_TOKEN}"
        }
      },
      "datadog": {
        "type": "remote",
        "url": "https://mcp.datadoghq.eu/v1/mcp",
        "headers": {
          "DD_API_KEY": "{env:DD_API_KEY}",
          "DD_APPLICATION_KEY": "{env:DD_APP_KEY}"
        }
      },
      "mempalace": {
        "type": "local",
        "disabled": true,
        "command": [
          "docker",
          "run",
          "-i",
          "--rm",
          "-v",
          "mempalace-data:/data",
          "mempalace"
        ]
      },
      "takealot": {
        "type": "local",
        "disabled": true,
        "command": [
          "/opt/homebrew/bin/npm",
          "--prefix",
          "/Users/ice/projects/mcp-takealot",
          "run",
          "-s",
          "stdio"
        ]
      },
      "float": {
        "type": "local",
        "disabled": true,
        "command": [
          "/Users/ice/.local/bin/uv",
          "--directory",
          "/Users/ice/projects/mcp-float",
          "run",
          "fastmcp",
          "run",
          "server.py:mcp"
        ],
        "environment": {
          "FLOAT_EMAIL": "{env:FLOAT_EMAIL}",
          "FLOAT_PASSWORD": "{env:FLOAT_PASSWORD}"
        }
      },
      "open": {
        "type": "remote",
        "disabled": true,
        "url": "http://127.0.0.1:18081/mcp"
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "grep-app": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      },
      "xero": {
        "type": "local",
        "command": [
          "uv",
          "--directory",
          "/Users/ice/projects/mcp-xero",
          "run",
          "mcp-xero"
        ],
        "disabled": true,
        "environment": {
          "MCP_XERO_DELIVERY": "chrome",
          "MCP_XERO_BRIDGE_PORT": "8765"
        }
      },
      "composio": {
        "type": "remote",
        "url": "https://connect.composio.dev/mcp",
        "disabled": true
      },
      "browse": {
        "type": "local",
        "command": ["npx", "-y", "@opencode/browse@latest", "mcp"]
      }
    }
  },
  "providers": {}
}

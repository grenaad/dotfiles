#!/usr/bin/env bash
#
# herdr-tabizer [path]
# if no path is given, using fzf, search in default locations

if ! command -v herdr > /dev/null 2>&1; then
    echo "herdr-tabizer: herdr is not installed or not in PATH" >&2
    exit 1
fi

if [[ $# -eq 1 ]]; then
    selected=$1
else
    if ! command -v fzf > /dev/null 2>&1; then
        echo "herdr-tabizer: fzf is not installed or not in PATH" >&2
        exit 1
    fi
    selected=$(find ~/work/focaldata ~/work/old/checkout ~/work ~/work2 ~/work3 ~/projects ~/ -mindepth 1 -maxdepth 1 -type d | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

if ! selected=$(cd -- "$selected" 2> /dev/null && pwd -P); then
    echo "herdr-tabizer: directory does not exist: $selected" >&2
    exit 1
fi

selected_name=$(basename "$selected" | tr "./" "__")

if ! command -v jq > /dev/null 2>&1; then
    echo "herdr-tabizer: jq is not installed or not in PATH" >&2
    exit 1
fi

if ! herdr status > /dev/null 2>&1; then
    if [[ -n ${HERDR_ENV:-} || -n ${HERDR_PANE_ID:-} ]]; then
        echo "herdr-tabizer: the herdr server is not reachable from this pane" >&2
    else
        echo "herdr-tabizer: the herdr server is not running; start herdr and retry" >&2
    fi
    exit 1
fi

# Popup commands receive HERDR_ACTIVE_WORKSPACE_ID but not HERDR_PANE_ID.
# Prefer injected context, then regular-pane context; outside herdr, use focus.
if [[ -n ${HERDR_ACTIVE_WORKSPACE_ID:-} ]]; then
    workspace_id=$HERDR_ACTIVE_WORKSPACE_ID
elif [[ -n ${HERDR_PANE_ID:-} ]]; then
    workspace_id=${HERDR_PANE_ID%%:*}
else
    if ! workspaces=$(herdr workspace list); then
        echo "herdr-tabizer: failed to list herdr workspaces" >&2
        exit 1
    fi
    workspace_id=$(jq -r '[.result.workspaces[] | select(.focused) | .workspace_id][0] // empty' <<< "$workspaces")
fi

if [[ -z $workspace_id ]]; then
    echo "herdr-tabizer: no target workspace is available" >&2
    exit 1
fi

if ! tabs=$(herdr tab list); then
    echo "herdr-tabizer: failed to list herdr tabs" >&2
    exit 1
fi
tab_id=$(jq -r --arg workspace "$workspace_id" --arg label "$selected_name" '[.result.tabs[] | select(.workspace_id == $workspace and .label == $label) | .tab_id][0] // empty' <<< "$tabs")

if [[ -n $tab_id ]]; then
    herdr tab focus "$tab_id"
else
    herdr tab create --workspace "$workspace_id" --cwd "$selected" --label "$selected_name" --focus
fi
